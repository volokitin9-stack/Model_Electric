# PostgreSQL. Локально — свой сервер (см. README → "Запуск") или тот же
# облачный адрес, что и в проде (тогда агенты и веб-клиент всегда видят
# одни данные). В проде это значение задаёт хостинг (Railway/Render —
# подставляется автоматически при подключении Postgres-плагина).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/modelelectric"
PORT=4000

# Ключ доступа ко всему API (кроме /api/health). Локально можно оставить
# пустым — тогда ключ не проверяется вообще. На публично задеплоенном
# сервере (Render/Railway/...) ОБЯЗАТЕЛЬНО задайте непустое случайное
# значение — иначе любой человек с ссылкой на сайт сможет менять и
# удалять данные без ограничений. Веб-клиент спросит этот ключ один раз
# в браузере и запомнит; Local Import Agent (apps/local-import-agent)
# берёт его из своего config.json (поле apiKey).
API_KEY=
