// Схема данных "Модельная электрика".
// PostgreSQL — единая база для локальной разработки и прод-деплоя
// (облачный Postgres, см. README → "Деплой"), чтобы агенты и веб видели
// одни и те же данные. Строковые статусы, миграции через Prisma —
// без изменений от прежнего прототипа на SQLite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Один проект модельной электропроводки.
// Статусные поля хранятся как строки (не Prisma enum) — допустимые
// значения для каждого поля определены в src/statuses.ts и проверяются
// в API (zod) на входе. Так выбор значений процесса "Заказ разъёмов"
// можно менять без миграции схемы.
model Project {
  id            String   @id @default(cuid())
  name          String
  article       String?
  responsible   String?

  overallStatus String   @default("active")

  // Отечественный/иномарка — правило по марке (всё под LADA — отечественные,
  // остальное — иномарки, подтверждено владельцем), а не совпадение текста
  // "на глаз": проставляется по первому слову названия при создании
  // проекта, но это обычное поле — его можно поправить вручную, если
  // классификация ошиблась. См. src/origin.ts.
  origin String @default("foreign")

  // 7 независимых процессов разработки
  searchConnectors  String @default("not_started")
  schemeDevelopment String @default("not_started")
  orderConnectors   String @default("not_started")
  payment           String @default("not_started")
  supplyConnectors  String @default("not_started")
  orderTooling      String @default("not_started")
  supplyTooling     String @default("not_started")

  plannedDate DateTime?

  // Продажи по данным Ozon (свод цен поставщиков, этап "prices" агента) —
  // период источника фиксированный: отчёт Ozon "за 28 дней", не настоящий
  // календарный месяц, поэтому храним как есть и подписываем в UI честно.
  salesQty28d      Int?
  salesSumRub      Decimal?
  salesAvgPriceRub Decimal?
  salesUpdatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  changes    ChangeLogEntry[]
  components ProjectComponent[]
  competitors ProjectCompetitor[]
  images     ProjectImage[]
  drawings   ProjectDrawing[]

  @@index([overallStatus])
  @@index([plannedDate])
}

// ---------------------------------------------------------------------
// Этап 2 — каталог комплектующих и поставщики. Единый источник правды:
// один ComponentCatalog на внутренний артикул, используется любым
// числом проектов через ProjectComponent; предложения поставщиков
// (SupplierCrossReference/SupplierPrice) общие для всех проектов, где
// встречается комплектующее — обновление цены у одного поставщика не
// затрагивает предложения других и видно сразу во всех проектах.
// ---------------------------------------------------------------------

model ComponentCategory {
  id   String @id @default(cuid())
  name String @unique

  components ComponentCatalog[]
}

model ComponentCatalog {
  id              String   @id @default(cuid())
  internalArticle String   @unique
  name            String
  categoryId      String?
  category        ComponentCategory? @relation(fields: [categoryId], references: [id])
  unit            String   @default("шт")
  imagePath       String?
  description     String?
  comment         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  projectComponents ProjectComponent[]
  crossReferences   SupplierCrossReference[]
  drawingConnectors DrawingConnector[]
  drawingPins       DrawingPin[]

  @@index([categoryId])
}

// Спецификация одного проекта — связка проект↔комплектующее со своим
// количеством/статусом/плановой ценой. Комплектующее само по себе не
// дублируется на проект, дублируется только эта связка.
model ProjectComponent {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  componentId String
  component   ComponentCatalog @relation(fields: [componentId], references: [id])

  quantity    Decimal  @default(1)
  status      String   @default("not_defined")

  primaryOfferId String?
  primaryOffer   SupplierCrossReference? @relation(fields: [primaryOfferId], references: [id])

  plannedPrice    Decimal?
  plannedCurrency String?
  comment         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, componentId])
  @@index([componentId])
  @@index([primaryOfferId])
}

model Supplier {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  country         String?
  contactPerson   String?
  phone           String?
  email           String?
  messenger       String?
  website         String?
  defaultCurrency String   @default("RUB")
  comment         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  crossReferences SupplierCrossReference[]
  importProfiles  SupplierImportProfile[]
  importBatches   SupplierImportBatch[]
  exportHistory   SupplierExportHistory[]
}

// Одна строка кроссировки = один вариант поставщика для одного нашего
// комплектующего. У комплектующего может быть много кроссировок (разные
// поставщики и/или разные артикулы одного поставщика); isPrimary — не
// более одной активной "основной" кроссировки на комплектующее задаётся
// через ProjectComponent.primaryOfferId (на уровне проекта, т.к. выбор
// основного поставщика может отличаться между проектами).
model SupplierCrossReference {
  id              String   @id @default(cuid())
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  componentId     String
  component       ComponentCatalog @relation(fields: [componentId], references: [id], onDelete: Cascade)
  supplierArticle String
  status          String   @default("active") // active | discontinued
  isPrimary       Boolean  @default(false)
  source          String   @default("manual") // manual | import
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prices           SupplierPrice[]
  priceHistory     SupplierPriceHistory[]
  usedAsPrimaryIn  ProjectComponent[]

  @@unique([supplierId, componentId, supplierArticle])
  @@index([componentId])
  @@index([supplierId])
}

// Append-only лог прочитанных цен (каждая загрузка/правка добавляет
// строку); актуальная цена кроссировки — самая свежая по effectiveAt.
model SupplierPrice {
  id                   String   @id @default(cuid())
  crossReferenceId     String
  crossReference       SupplierCrossReference @relation(fields: [crossReferenceId], references: [id], onDelete: Cascade)
  price                Decimal
  currency             String
  minimumOrderQuantity Int?
  availability         String?
  leadTimeDays         Int?
  effectiveAt          DateTime @default(now())
  importedAt           DateTime @default(now())
  sourceFileId         String?
  sourceFile           SupplierImportBatch? @relation(fields: [sourceFileId], references: [id])

  @@index([crossReferenceId, effectiveAt])
}

// Фиксирует именно ИЗМЕНЕНИЕ цены (old→new) — отдельно от SupplierPrice,
// чтобы "история цены" в UI не приходилось собирать diff'ом на лету.
model SupplierPriceHistory {
  id               String   @id @default(cuid())
  crossReferenceId String
  crossReference   SupplierCrossReference @relation(fields: [crossReferenceId], references: [id], onDelete: Cascade)
  oldPrice         Decimal?
  newPrice         Decimal
  currency         String
  changedAt        DateTime @default(now())
  sourceFileId     String?

  @@index([crossReferenceId, changedAt])
}

// Сохранённый шаблон сопоставления колонок конкретного файла
// поставщика — настраивается один раз, переиспользуется при каждом
// следующем обновлении (см. README про Local Import Agent).
model SupplierImportProfile {
  id             String   @id @default(cuid())
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  profileName    String
  fileType       String   // xlsx | xls | csv
  sheetName      String?
  headerRow      Int      @default(1)
  dataStartRow   Int      @default(2)
  columnMapping  String   // JSON: {ourArticle, supplierArticle, price, currency, availability, moq, leadTimeDays}
  importOptions  String?  // JSON: доп. опции парсинга
  localSourceKey String?  // код подпапки локального агента (напр. SUP01)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  batches SupplierImportBatch[]

  @@index([supplierId])
}

model SupplierImportBatch {
  id           String   @id @default(cuid())
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  profileId    String?
  profile      SupplierImportProfile? @relation(fields: [profileId], references: [id])
  sourceFile   String
  sourceHash   String
  importedAt   DateTime @default(now())
  rowsRead     Int      @default(0)
  rowsCreated  Int      @default(0)
  rowsUpdated  Int      @default(0)
  rowsRejected Int      @default(0)
  status       String   @default("pending") // pending|previewed|applied|failed
  reportJson   String?

  prices SupplierPrice[]

  @@index([supplierId, sourceHash])
}

model ProjectCompetitor {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sellerName  String
  productName String
  productUrl  String?
  price       Decimal?
  currency    String?
  comment     String?
  checkedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model ProjectImage {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imagePath  String
  mimeType   String
  sizeBytes  Int
  uploadedAt DateTime @default(now())

  @@index([projectId])
}

model SupplierExportHistory {
  id                 String   @id @default(cuid())
  supplierId         String
  supplier           Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  selectedProjectIds String   // JSON-массив id проектов
  exportedAt         DateTime @default(now())
  rowsExported       Int
  excludedRows       Int
  exportStatus       String   // success|cancelled

  @@index([supplierId])
}

// Журнал изменений — одна запись на изменённое поле при каждом
// сохранении. Не хранит "кто" по-настоящему (авторизации пока нет),
// поле changedBy зарезервировано под будущую систему пользователей.
model ChangeLogEntry {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  field      String
  fieldLabel String
  oldValue   String?
  newValue   String?

  changedBy  String   @default("Jarvis")
  changedAt  DateTime @default(now())

  @@index([projectId])
  @@index([changedAt])
}


// ---------------------------------------------------------------------
// Чертежи жгутов (вкладка «Электросхемы»). Заполняются агентом
// apps/spec-import-agent из specs/Wiring_N/Wiring_N_spec.xlsx. Чертёж —
// источник правды для своих разъёмов/распиновки/замечаний: при каждой
// загрузке они заменяются целиком (ручного редактирования этих таблиц
// в вебе нет). contentHash позволяет не перезаписывать и не плодить
// записи журнала, если содержимое файла не изменилось.
// ---------------------------------------------------------------------

model ProjectDrawing {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  drawingNo   Int      @unique
  brand       String
  model       String
  sourceFile  String?
  sheetsJson  String   // JSON: [{sheet, description}]
  contentHash String
  importedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connectors DrawingConnector[]
  pins       DrawingPin[]
  notes      DrawingNote[]

  @@index([projectId])
}

// componentId — связь с общим каталогом комплектующих по нормализованному
// housingPn (см. normalizeArticle в src/normalize.ts): один и тот же
// разъём, встретившийся в разных чертежах/моделях, указывает на одну и
// ту же запись каталога — цену/поставщика ищем один раз, не на каждую
// модель заново (проставляется сервером при PUT, см. routes/drawings.ts).
model DrawingConnector {
  id           String  @id @default(cuid())
  drawingId    String
  drawing      ProjectDrawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  sortOrder    Int
  sheet        String
  designator   String
  bomPosition  String?
  purpose      String?
  housingPn    String?
  manufacturer String?
  positions    String?
  contactPn    String?
  contactQty   String?
  status       String?
  note         String?

  componentId  String?
  component    ComponentCatalog? @relation(fields: [componentId], references: [id])

  @@index([drawingId])
  @@index([componentId])
}

// componentId — связь с общим каталогом комплектующих по нормализованному
// contactPn (тот же принцип, что у DrawingConnector.componentId выше).
model DrawingPin {
  id                String  @id @default(cuid())
  drawingId         String
  drawing           ProjectDrawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  sortOrder         Int
  sheet             String
  connector         String
  housingPn         String?
  contactPn         String?
  pin               String?
  wire              String?
  color             String?
  crossSection      String?
  destination       String?
  doubleCrimp       Boolean @default(false)
  crossSectionCheck String?
  note              String?

  componentId       String?
  component         ComponentCatalog? @relation(fields: [componentId], references: [id])

  @@index([drawingId])
  @@index([componentId])
}

model DrawingNote {
  id             String  @id @default(cuid())
  drawingId      String
  drawing        ProjectDrawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  number         Int
  topic          String?
  text           String
  recommendation String?

  @@index([drawingId])
}
